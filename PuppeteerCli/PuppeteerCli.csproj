<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Paper 7 Phase 2 CLI: the "Rubicon-equivalent" issuer that emits
    onboarding share-links for Docker hosts. Designed to run on an
    operator's laptop, emit a QR-friendly string, complete the
    F1-F5 Usher handshake with one or more Kora-equivalents
    (PuppeteerHost containers), and then exit.

    See notes/paper7_phase1_results.md for context. Phase 2's analog
    Usher hop performs the QR transport step (print, photograph, OCR
    to container) outside any wire; this CLI does the digital half.

    Sits outside Puppeteer.sln by convention, matching the
    UnitTestEShopOnPuppeteer / UnitTestPaper7EShop layout.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>PuppeteerCli</RootNamespace>
    <AssemblyName>puppeteer-cli</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puppeteer\Puppeteer.csproj" />
    <ProjectReference Include="..\Choreography\Choreography.csproj" />
  </ItemGroup>

</Project>
